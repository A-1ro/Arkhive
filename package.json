{
  "name": "arkhive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security-report": "node --test scripts/security-report.test.mjs",
    "security:collect": "node scripts/collect-security-report.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:legacy": "wrangler deploy --config wrangler.legacy.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format:check": "prettier --check src tests scripts/*.mjs .agents .github index.html package.json pnpm-workspace.yaml tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc README.md",
    "check:native": "node scripts/check-native-dependencies.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@10.34.7"
}
